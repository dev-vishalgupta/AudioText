# The default Windows store uses DPAPI CurrentUser; no encryption key is needed.
# Optional credential location (must be private to the current OS user):
# AUDIOTEXT_DATA_DIR=
# Non-Windows, single-user installations ONLY: inject a 32-byte base64 encryption
# key from an OS secret manager. Never store it alongside credentials or commit it.
# AUDIOTEXT_MASTER_KEY=
# Override only when running locally on another port:
AUDIOTEXT_ORIGIN=http://127.0.0.1:3100
# Default: prefer IPv4 to work around broken IPv6 routes on local networks.
# Set to auto only if your network requires IPv6 / automatic address selection.
# AUDIOTEXT_NETWORK_FAMILY=auto
